@page "/set-values"

<PageTitle>Set fresh values</PageTitle>

<h1>Set fresh values</h1>
<p>Seed: <strong id="seed">@Seed</strong></p>
<p>These nullable attributed properties were assigned during this request and are written to storage at request completion.</p>

<ValidationValueTable Rows="Rows" />

<p><a class="btn btn-primary" href="display-values">Start request-count test</a></p>

@code {
    [SupplyParameterFromTempData(Name = "validation-temp-explicit")]
    public string? TempExplicit { get; set; }

    [SupplyParameterFromTempData]
    public string? TempDefault { get; set; }

    [SupplyParameterFromSession(Name = "validation-session-explicit")]
    public string? SessionExplicit { get; set; }

    [SupplyParameterFromSession]
    public string? SessionDefault { get; set; }

    [SupplyParameterFromTempData(Name = "validation-temp-a")]
    public string? TempDistinctA { get; set; }

    [SupplyParameterFromTempData(Name = "validation-temp-b")]
    public string? TempDistinctB { get; set; }

    [SupplyParameterFromSession(Name = "validation-session-a")]
    public string? SessionDistinctA { get; set; }

    [SupplyParameterFromSession(Name = "validation-session-b")]
    public string? SessionDistinctB { get; set; }

    private string Seed { get; set; } = string.Empty;

    private IReadOnlyList<ValidationValueTable.ValidationValueRow> Rows =>
    [
        new("TempData", nameof(TempExplicit), "validation-temp-explicit", TempExplicit),
        new("TempData", nameof(TempDefault), nameof(TempDefault), TempDefault),
        new("Session", nameof(SessionExplicit), "validation-session-explicit", SessionExplicit),
        new("Session", nameof(SessionDefault), nameof(SessionDefault), SessionDefault)
    ];

    protected override void OnInitialized()
    {
        Seed = $"{DateTimeOffset.UtcNow:yyyyMMdd-HHmmss-fff}-{Guid.NewGuid().ToString("N")[..6]}";
        TempExplicit = $"TEMP-EXPLICIT-{Seed}";
        TempDefault = $"TEMP-DEFAULT-{Seed}";
        SessionExplicit = $"SESSION-EXPLICIT-{Seed}";
        SessionDefault = $"SESSION-DEFAULT-{Seed}";
        TempDistinctA = $"TEMP-A-{Seed}";
        TempDistinctB = $"TEMP-B-{Seed}";
        SessionDistinctA = $"SESSION-A-{Seed}";
        SessionDistinctB = $"SESSION-B-{Seed}";
    }
}